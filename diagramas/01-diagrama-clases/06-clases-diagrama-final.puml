@startuml 06-clases-diagrama-final

skinparam backgroundColor #FFFFFF
skinparam classAttributeIconSize 0
skinparam class {
    BackgroundColor #EFF6FF
    BorderColor #3B82F6
    ArrowColor #1D4ED8
    FontColor #1E3A8A
}
skinparam note {
    BackgroundColor #DBEAFE
    BorderColor #93C5FD
}

title Diagrama de Clases Final — Sistema de Turnos Médicos

' ================================================================
' PAQUETE: Jerarquía de Personas
' ================================================================
package "Jerarquía de Personas" {

    abstract class Persona {
        --
        # nombre: String
        # apellido: String
        # telefono: String
        # email: String
        # rol: String
        # estadoActivo: Boolean
        # dni: String
        --
        + getDatos(): String
        + getContacto(): String
        + notificar(mensaje: String): void
    }

    class Paciente {
        # numeroAfiliado: String
        # historialMedico: String
        --
        + solicitarTurno(medico: Medico, fecha: Date, hora: String): Turno
        + cancelarTurno(turno: Turno): void
        + consultarHistorial(): List<Turno>
    }

    class Medico {
        # matricula: String
        # especialidad: String
        --
        + definirDisponibilidad(fecha: Date, horario: String): void
        + autorizarSobreturno(turno: Turno): void
        + obtenerAgenda(): Agenda
        + accederAgenda(tipoVista: String, fechaActual: Date): Resultado
        + notificar(mensaje: String): void
    }

    class Secretaria {
        # legajo: String
        --
        + registrarTurno(paciente: Paciente, medico: Medico, fecha: Date, hora: String): Turno
        + consultarDisponibilidad(medico: Medico, fecha: Date): List<String>
        + cancelarTurno(turno: Turno): void
        + reprogramarTurno(turno: Turno, nuevaFecha: Date, nuevaHora: String): void
        + buscarTurnoPaciente(apellido: String, nombre: String, dni: String): void
        + registrarPresencia(turno: Turno): void
        + accederAgenda(tipoVista: String, fechaActual: Date): Resultado
        + notificar(mensaje: String): void
    }

    Persona <|-- Paciente
    Persona <|-- Medico
    Persona <|-- Secretaria
}

' ================================================================
' PAQUETE: Gestión de Turnos
' ================================================================
package "Gestión de Turnos" {

    class Turno {
        --
        - fecha: Date
        - hora: Time
        - estado: String
        - tipoConsulta: String
        - fechaRegistro: DateTime
        --
        + getEstado(): String
        + getFechaHora(): DateTime
        + establecerEstado(nuevoEstado: String): void
        + cambiarEstado(nuevoEstado: String): void
        + actualizarFechaHora(nuevaFecha: Date, nuevaHora: Time): void
        + bloquearFranja(duracionMinutos: Integer): void
        + obtenerDuracion(): Integer
        + validarRestricciones(): Boolean
    }

    class Agenda {
        {id} idAgenda: UUID
        --
        - listaTurnos: List<Turno>
        - horariosDisponibles: Map<Date, List<String>>
        - medico: Medico
        - gestorBloqueos: GestorBloqueos
        --
        + consultarDisponibilidad(matricula: String, semana: Date): List<Turno>
        + obtenerHorariosDelDia(fecha: Date, matricula: String): List<String>
        + filtrarHorariosDisponibles(fecha: Date, matricula: String): List<String>
        + registrarTurno(datos: Map): Turno
        + validarRestricciones(tipoConsulta: String, fecha: Date, hora: String): Boolean
        + bloquearFranjaHoraria(fecha: Date, hora: String, duracion: Integer): void
        + liberarFranjaAnterior(fechaAnterior: Date, horaAnterior: Time): void
        + bloquearNuevaFranja(nuevaFecha: Date, nuevaHora: Time): void
        + registrarPresencia(idTurno: UUID): LlegadaPaciente
        + cancelarRecordatoriosPendientes(idTurno: UUID): void
        + reprogramarTurno(turno: Turno, nuevaFecha: Date, nuevaHora: Time): void
        + bloquearRango(rango: RangoFechaHora, motivo: String): Resultado
        + obtenerTurnosPorRango(rango: RangoFechaHora): List<Turno>
        + obtenerVistaDiaria(fecha: Date): VistaCalendario
        + obtenerVistaSemanal(fechaInicio: Date): VistaCalendario
        + getGestorBloqueos(): GestorBloqueos
    }

    class LlegadaPaciente {
        --
        - horaLlegada: Time
        - presente: Boolean
        - estadoPresencia: String
        --
        + registrarHoraLlegada(): void
        + actualizarPresencia(presente: Boolean, estado: String): void
        + cambiarEstado(estado: String): void
        + notificarMedico(medico: Medico): void
    }

    class HistorialTurno {
        --
        - fechaCambio: DateTime
        - fechaAnterior: Date
        - horaAnterior: Time
        - fechaNueva: Date
        - horaNueva: Time
        - secretaria: String
        --
        + registrarCambio(fechaAnterior: Date, horaAnterior: Time, fechaNueva: Date, horaNueva: Time): void
    }

    Agenda "1" *-- "*" Turno : contiene
    Agenda "1" *-- "*" HistorialTurno : registra en
    Agenda ..> LlegadaPaciente : <<crea>>
    LlegadaPaciente "0..1" --> "1" Turno : actualiza estado de
}

' ================================================================
' PAQUETE: Control y Presentación
' ================================================================
package "Control y Presentación" {

    class ControlSistema {
        --
        + buscarTurnoPaciente(apellido: String, nombre: String, dni: String): Turno
        + seleccionarTurno(turno: Turno): void
        + registrarPresencia(turno: Turno): void
        + confirmarCheckIn(): void
        + seleccionarReprogramar(turno: Turno): void
        + validarRestricciones(tipoConsulta: String, fecha: Date, hora: Time): Boolean
        + confirmarReprogramacion(): void
        + seleccionarRango(fechaInicio: Date, fechaFin: Date): Resultado
        + ingresarMotivo(motivo: String): Resultado
        + confirmarBloqueo(fechaInicio: Date, fechaFin: Date, motivo: String): Resultado
        + accederAgenda(dni: String, rol: String): Resultado
        + cargarVista(tipoVista: String, fecha: Date): Resultado
        + navegarFecha(direccion: String): Date
        + cerrarVista(): void
    }

    class VistaCalendario {
        --
        - periodoActual: Date
        - tipoVista: String
        --
        + mostrarVistaDiaria(turnos: List<Turno>, bloqueos: List<Bloqueo>): void
        + mostrarVistaSemanal(turnos: List<Turno>, bloqueos: List<Bloqueo>): void
        + mostrarBloqueos(bloqueos: List<Bloqueo>): void
        + mostrarTurnos(turnos: List<Turno>): void
        + navegarFecha(direccion: String): Date
    }

    class GestorBloqueos {
        --
        - bloqueos: List<Bloqueo>
        - reglasHorario: Map
        --
        + bloquearRango(rango: RangoFechaHora, motivo: String): void
        + estaBloqueado(fecha: Date, hora: Time): Boolean
        + obtenerMotivo(fecha: Date, hora: Time): String
        + obtenerBloqueosPorFecha(fecha: Date): List<Bloqueo>
    }

    class ValidadorDisponibilidad {
        --
        - horariosHabilitados: Map
        --
        + validarRango(rango: RangoFechaHora): Boolean
        + estaDisponible(fecha: Date, hora: Time, tipo: String): Boolean
        + obtenerSlotsLibres(fecha: Date): List<Time>
    }

    class Bloqueo {
        --
        - fechaInicio: Date
        - fechaFin: Date
        - motivo: String
        --
        + contiene(fecha: Date, hora: Time): Boolean
    }

    class RangoFechaHora {
        --
        - fechaInicio: Date
        - fechaFin: Date
        - horaInicio: Time
        - horaFin: Time
        --
        + validar(): Boolean
    }

    class Resultado {
        --
        - exito: Boolean
        - mensaje: String
        --
        + {static} ok(msg: String): Resultado
        + {static} error(msg: String): Resultado
    }

    GestorBloqueos "1" *-- "*" Bloqueo : administra
}

' ================================================================
' PAQUETE: Servicios
' ================================================================
package "Servicios" {

    class ServicioNotificacion {
        --
        - canalWhatsApp: String
        - telefono: String
        - idServicio: UUID
        --
        + enviarConfirmacion(telefono: String, fecha: Date, hora: String, medico: String): Boolean
        + programarRecordatorio24h(telefono: String, fecha: Date): void
        + programarRecordatorioManana(telefono: String, fecha: Date): void
        + enviarCancelacion(telefono: String, fecha: Date): Boolean
        + enviarReprogramacion(telefono: String, nuevaFecha: Date, nuevaHora: String): Boolean
        + reprogramarRecordatorio(telefono: String, nuevaFecha: Date, nuevaHora: Time): void
    }
}

' ================================================================
' RELACIONES ENTRE PAQUETES
' ================================================================

' Control → dominio
Secretaria ..> ControlSistema : <<usa>>
Medico --> ControlSistema : solicita acceso
ControlSistema "1" --> "1" Agenda : delega a
ControlSistema --> VistaCalendario : presenta
ControlSistema --> Resultado : retorna

' Agenda → servicios y control
Agenda --> ValidadorDisponibilidad : usa
Agenda ..> ServicioNotificacion : <<crea>>
Agenda --> VistaCalendario : actualiza
Agenda --> GestorBloqueos : usa

' Turno → personas
Turno --> Paciente : asignado a
Turno --> Medico : atendido por

' Notificaciones
LlegadaPaciente ..> Medico : notifica

' Dependencias de valor
Agenda ..> RangoFechaHora : usa
ValidadorDisponibilidad ..> RangoFechaHora : valida

@enduml
