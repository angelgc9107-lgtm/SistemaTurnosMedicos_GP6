@startuml poo-polimorfismo-alan
skinparam backgroundColor #FFFFFF
skinparam classAttributeIconSize 0
skinparam class {
    BackgroundColor #EFF6FF
    BorderColor #3B82F6
    ArrowColor #1D4ED8
    FontColor #1E3A8A
}
skinparam note {
    BackgroundColor #DBEAFE
    BorderColor #93C5FD
}

abstract class Persona {
    + notificar(mensaje: String): void
}

class Medico {
    + notificar(mensaje: String): void
}

class Secretaria {
    + notificar(mensaje: String): void
}

Persona <|-- Medico
Persona <|-- Secretaria

note right of Medico : Publica una alerta\nen el panel médico
note right of Secretaria : Registra la notificación\nen el sistema de gestión
@enduml
